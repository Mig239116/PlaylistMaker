<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="MainContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HeaderContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/gap_4</item>
    </style>

    <style name="HeaderTitle">
        <item name="android:layout_width">@dimen/zero_size</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">@dimen/gap_12</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/header_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="HeaderTitle.Main">
        <item name="android:textColor">@color/yp_white</item>
    </style>

    <style name="HeaderBackButton">
        <item name="android:layout_width">@dimen/icon_large</item>
        <item name="android:layout_height">@dimen/icon_large</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="tint">@color/icon_tint</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:padding">@dimen/gap_12</item>
        <item name="android:contentDescription">@string/back</item>
    </style>

    <style name="HeaderIcon">
        <item name="android:layout_width">@dimen/icon_large</item>
        <item name="android:layout_height">@dimen/icon_large</item>
        <item name="android:src">@drawable/ic_search</item>
        <item name="android:visibility">gone</item>
        <item name="tint">@color/icon_tint</item>
        <item name="android:padding">@dimen/gap_12</item>
        <item name="android:contentDescription">@string/search</item>
    </style>

    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginBottom">@dimen/gap_16</item>
        <item name="android:insetTop">@dimen/zero_size</item>
        <item name="android:insetBottom">@dimen/zero_size</item>
        <item name="android:elevation">@dimen/zero_size</item>
        <item name="elevation">@dimen/zero_size</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">@dimen/header_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/text_main_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/gap_8</item>
        <item name="iconTint">@color/icon_color</item>
        <item name="cornerRadius">@dimen/corner_radius_16</item>
        <item name="android:backgroundTint">@color/button_background</item>
    </style>

    <style name="MainMenuButton.Last">
        <item name="android:layout_marginBottom">@dimen/zero_size</item>
    </style>

    <style name="LibraryTab">
        <item name="android:layout_width">@dimen/zero_size</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="LibraryTabText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/library_tab_text_size</item>
        <item name="android:textColor">@color/library_text_primary</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="NavigationTab">
        <item name="android:layout_width">@dimen/zero_size</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="NavigationTabIcon">
        <item name="android:layout_width">@dimen/icon_small</item>
        <item name="android:layout_height">@dimen/icon_small</item>
        <item name="tint">@color/tab_inactive</item>
    </style>

    <style name="NavigationTabText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/tab_text_size</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/tab_inactive</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_list_item_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/gap_16</item>
        <item name="android:paddingEnd">@dimen/gap_12</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsItemText">
        <item name="android:layout_width">@dimen/zero_size</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/settings_size</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsItemIcon">
        <item name="android:layout_width">@dimen/icon_small</item>
        <item name="android:layout_height">@dimen/icon_small</item>
        <item name="tint">@color/settings_icon_secondary</item>
    </style>

    <style name="CustomSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="android:thumb">@drawable/switch_thumb_shape</item>
        <item name="android:track">@drawable/switch_track_shape</item>
        <item name="android:switchMinWidth">32dp</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
    </style>

    <style name="LibraryEmptyImage">
        <item name="android:src">@drawable/ic_library_empty</item>
    </style>

    <style name="SearchBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/search_bar_height</item>
        <item name="android:paddingHorizontal">@dimen/gap_16</item>
        <item name="android:paddingTop">@dimen/gap_8</item>
        <item name="android:paddingBottom">@dimen/gap_8</item>
        <item name="android:background">@color/search_background</item>
    </style>

    <style name="SearchEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/search_field_height</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:clickable">true</item>
        <item name="android:cursorVisible">true</item>
        <item name="android:drawableStart">@drawable/ic_search_small</item>
        <item name="android:drawablePadding">@dimen/gap_8</item>
        <item name="android:drawableTint">@color/search_placeholder</item>
        <item name="android:enabled">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:hint">@string/search</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:inputType">text</item>
        <item name="android:isScrollContainer">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/gap_12</item>
        <item name="android:paddingEnd">@dimen/search_clear_width</item>
        <item name="android:textColor">@color/search_text_primary</item>
        <item name="android:textColorHint">@color/search_placeholder</item>
        <item name="android:textSize">@dimen/settings_size</item>
    </style>

    <style name="TrackItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/track_item_height</item>
        <item name="android:background">@color/search_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/track_item_padding_start</item>
        <item name="android:paddingEnd">@dimen/track_item_padding_end</item>
    </style>

    <style name="TrackArtwork">
        <item name="android:layout_width">@dimen/track_artwork_size</item>
        <item name="android:layout_height">@dimen/track_artwork_size</item>
        <item name="android:layout_marginEnd">@dimen/gap_8</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/ic_placeholder</item>
    </style>

    <style name="TrackName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/track_name</item>
        <item name="android:textSize">@dimen/track_name_text_size</item>
    </style>

    <style name="TrackMetaText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/track_meta</item>
        <item name="android:textSize">@dimen/track_meta_text_size</item>
    </style>

    <style name="TrackArrow">
        <item name="android:layout_width">@dimen/icon_small</item>
        <item name="android:layout_height">@dimen/icon_small</item>
        <item name="android:src">@drawable/ic_forward</item>
        <item name="tint">@color/track_meta</item>
    </style>

    <style name="TrackDot">
        <item name="android:layout_width">@dimen/track_dot_size</item>
        <item name="android:layout_height">@dimen/track_dot_size</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_dot</item>
        <item name="tint">@color/track_meta</item>
    </style>

    <style name="SearchClearButton">
        <item name="android:layout_width">@dimen/search_clear_width</item>
        <item name="android:layout_height">@dimen/search_field_height</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:src">@drawable/ic_clear</item>
        <item name="tint">@color/search_placeholder</item>
        <item name="android:paddingHorizontal">@dimen/gap_12</item>
        <item name="android:paddingVertical">@dimen/search_clear_padding_vertical</item>
        <item name="android:visibility">gone</item>
        <item name="android:contentDescription">@string/clear_search</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
