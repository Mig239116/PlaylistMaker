<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/search_background">

    <LinearLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gap_12">

        <TextView
            android:layout_width="@dimen/zero_size"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/search"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/header_size"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:includeFontPadding="false" />

        <ImageView
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_search"
            android:visibility="gone"
            app:tint="@color/icon_tint"
            android:padding="@dimen/gap_12"
            android:contentDescription="@string/search" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gap_16"
        android:background="@color/search_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/search_field_background"
            android:paddingStart="@dimen/gap_12"
            android:paddingEnd="@dimen/gap_12"
            app:cornerRadius="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:visibility="gone"
                app:tint="@color/search_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_12"
                android:text="@string/search"
                android:textColor="@color/search_placeholder"
                android:textSize="@dimen/settings_size"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/zero_size"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/search_background">

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/tab_bar_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:background="@color/search_background">

        <LinearLayout
            android:id="@+id/tab_search"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_search"
                app:tint="@color/tab_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_active"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_library"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_media"
                app:tint="@color/tab_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_inactive"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_settings"
                app:tint="@color/tab_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_inactive"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>