<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/library_background">

    <LinearLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gap_12">

        <TextView
            android:layout_width="@dimen/zero_size"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library"
            android:textColor="@color/library_text_primary"
            android:textSize="@dimen/header_size"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:includeFontPadding="false" />

        <ImageView
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:src="@drawable/ic_search"
            android:visibility="gone"
            app:tint="@color/icon_tint"
            android:padding="@dimen/gap_12"
            android:contentDescription="@string/search" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/library_background">

        <LinearLayout
            android:id="@+id/tab_left"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracks"
                android:textSize="@dimen/library_tab_text_size"
                android:textColor="@color/library_text_primary"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_indicator_height"
                android:layout_marginLeft="@dimen/tab_indicator_margin_horizontal"
                android:layout_marginRight="@dimen/tab_indicator_margin_horizontal"
                android:background="@color/library_tab_indicator"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_right"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlists"
                android:textSize="@dimen/library_tab_text_size"
                android:textColor="@color/library_text_primary"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_indicator_height"
                android:layout_marginLeft="@dimen/tab_indicator_margin_horizontal"
                android:layout_marginRight="@dimen/tab_indicator_margin_horizontal"
                android:background="@color/library_tab_indicator" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/zero_size"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/gap_24">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_library_empty"
            android:contentDescription="@string/empty_library"
            android:layout_marginBottom="@dimen/gap_16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_library_text"
            android:textSize="19sp"
            android:textColor="@color/library_text_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineHeight="22sp" />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/tab_bar_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:background="@color/library_background">

        <LinearLayout
            android:id="@+id/tab_search"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_search"
                app:tint="@color/tab_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_inactive"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_library"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_media"
                app:tint="@color/tab_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_active"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="@dimen/zero_size"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:src="@drawable/ic_settings"
                app:tint="@color/tab_inactive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="@dimen/tab_text_size"
                android:letterSpacing="0.04"
                android:textColor="@color/tab_inactive"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>