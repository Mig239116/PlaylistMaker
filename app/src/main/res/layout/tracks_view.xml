<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TrackItem"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_item_height"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/art_work"
        style="@style/TrackArtwork"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gap_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_name"
            style="@style/TrackName"
            tools:text="Smells Like Teen Spirit" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/track_info_margin_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/artist_name"
                style="@style/TrackMetaText"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                tools:text="Nirvana" />

            <ImageView
                style="@style/TrackDot" />

            <TextView
                android:id="@+id/track_time"
                style="@style/TrackMetaText"
                android:layout_width="wrap_content"
                tools:text="5:01" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/arrow"
        style="@style/TrackArrow"
        tools:ignore="ContentDescription" />
</LinearLayout>
